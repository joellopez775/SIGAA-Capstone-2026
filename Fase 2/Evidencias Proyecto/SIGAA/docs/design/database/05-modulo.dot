digraph SIGAA {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.55, ranksep=1.3, splines=polyline, pad=0.3, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#82968b", fontcolor="#314f40", arrowsize=0.65];
"asistencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#5c6651"><TR><TD COLSPAN="3" BGCOLOR="#5c6651"><FONT COLOR="white" POINT-SIZE="12"><B>asistencia</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">sesion_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R17 !</TD></TR><TR><TD ALIGN="LEFT">estudiante_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R15 !</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">observacion</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">registrada_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R16 !</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"comunicacion_estudiante" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#5c6651"><TR><TD COLSPAN="3" BGCOLOR="#5c6651"><FONT COLOR="white" POINT-SIZE="12"><B>comunicacion_estudiante</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">estudiante_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R31 !</TD></TR><TR><TD ALIGN="LEFT">curso_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R30 ?</TD></TR><TR><TD ALIGN="LEFT">curso_asignatura_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R29 ?</TD></TR><TR><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT">varchar(180)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">detalle</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">visible_desde</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">visible_hasta</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">creada_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R28 !</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"curso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#78877d"><TR><TD COLSPAN="3" BGCOLOR="#78877d"><FONT COLOR="white" POINT-SIZE="12"><B>curso</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f2f4f1"><FONT POINT-SIZE="9">Referencia a otro módulo</FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR></TABLE>>];
"curso_asignatura" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#78877d"><TR><TD COLSPAN="3" BGCOLOR="#78877d"><FONT COLOR="white" POINT-SIZE="12"><B>curso_asignatura</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f2f4f1"><FONT POINT-SIZE="9">Referencia a otro módulo</FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR></TABLE>>];
"estudiante" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#78877d"><TR><TD COLSPAN="3" BGCOLOR="#78877d"><FONT COLOR="white" POINT-SIZE="12"><B>estudiante</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f2f4f1"><FONT POINT-SIZE="9">Referencia a otro módulo</FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR></TABLE>>];
"justificacion_ausencia" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#5c6651"><TR><TD COLSPAN="3" BGCOLOR="#5c6651"><FONT COLOR="white" POINT-SIZE="12"><B>justificacion_ausencia</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">estudiante_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R50 !</TD></TR><TR><TD ALIGN="LEFT">fecha_desde</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">fecha_hasta</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">documento_url</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">registrada_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R51 !</TD></TR><TR><TD ALIGN="LEFT">revisada_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R52 ?</TD></TR><TR><TD ALIGN="LEFT">revisada_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">sesion_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R53 ?</TD></TR><TR><TD ALIGN="LEFT">observacion_revision</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"sesion_clase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#5c6651"><TR><TD COLSPAN="3" BGCOLOR="#5c6651"><FONT COLOR="white" POINT-SIZE="12"><B>sesion_clase</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">curso_asignatura_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R66 !</TD></TR><TR><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">bloque</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT">varchar(180)</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">objetivo</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">contenido</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">hora_inicio</TD><TD ALIGN="LEFT">time without time zone</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">hora_fin</TD><TD ALIGN="LEFT">time without time zone</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">sala</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">creada_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R65 ?</TD></TR><TR><TD ALIGN="LEFT">publicada</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">publicada_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#78877d"><TR><TD COLSPAN="3" BGCOLOR="#78877d"><FONT COLOR="white" POINT-SIZE="12"><B>usuario</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f2f4f1"><FONT POINT-SIZE="9">Referencia a otro módulo</FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR></TABLE>>];
"asistencia" -> "estudiante" [label="R15  0..N : 1", style="solid"];
"asistencia" -> "usuario" [label="R16  0..N : 1", style="solid"];
"asistencia" -> "sesion_clase" [label="R17  0..N : 1", style="solid"];
"comunicacion_estudiante" -> "usuario" [label="R28  0..N : 1", style="solid"];
"comunicacion_estudiante" -> "curso_asignatura" [label="R29  0..N : 0..1", style="dashed"];
"comunicacion_estudiante" -> "curso" [label="R30  0..N : 0..1", style="dashed"];
"comunicacion_estudiante" -> "estudiante" [label="R31  0..N : 1", style="solid"];
"justificacion_ausencia" -> "estudiante" [label="R50  0..N : 1", style="solid"];
"justificacion_ausencia" -> "usuario" [label="R51  0..N : 1", style="solid"];
"justificacion_ausencia" -> "usuario" [label="R52  0..N : 0..1", style="dashed"];
