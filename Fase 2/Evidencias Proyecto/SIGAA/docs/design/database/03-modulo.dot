"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#78877d"><TR><TD COLSPAN="3" BGCOLOR="#78877d"><FONT COLOR="white" POINT-SIZE="12"><B>usuario</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f2f4f1"><FONT POINT-SIZE="9">Referencia a otro módulo</FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR></TABLE>>];
