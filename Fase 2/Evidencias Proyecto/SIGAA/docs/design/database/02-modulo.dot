digraph SIGAA {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.55, ranksep=1.3, splines=polyline, pad=0.3, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#82968b", fontcolor="#314f40", arrowsize=0.65];
"asignacion_docente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#285e55"><TR><TD COLSPAN="3" BGCOLOR="#285e55"><FONT COLOR="white" POINT-SIZE="12"><B>asignacion_docente</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">curso_asignatura_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R13 !</TD></TR><TR><TD ALIGN="LEFT">funcionario_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R14 !</TD></TR><TR><TD ALIGN="LEFT">funcion</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">vigente_desde</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">vigente_hasta</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">puede_planificar</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">puede_registrar_asistencia</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">puede_calificar</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"asignatura" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#285e55"><TR><TD COLSPAN="3" BGCOLOR="#285e55"><FONT COLOR="white" POINT-SIZE="12"><B>asignatura</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">U !</TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">varchar(160)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
