digraph SIGAA {
graph [rankdir=LR, bgcolor="transparent", nodesep=0.55, ranksep=1.3, splines=polyline, pad=0.3, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#82968b", fontcolor="#314f40", arrowsize=0.65];
"app_metadata" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>app_metadata</B></FONT></TD></TR><TR><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"evento_auditoria" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>evento_auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R46 ?</TD></TR><TR><TD ALIGN="LEFT">accion</TD><TD ALIGN="LEFT">varchar(80)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">entidad</TD><TD ALIGN="LEFT">varchar(80)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">entidad_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">valor_anterior</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">valor_nuevo</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">correlacion_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">origen</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"funcionario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>funcionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">U R47 !</TD></TR><TR><TD ALIGN="LEFT">run</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">U ?</TD></TR><TR><TD ALIGN="LEFT">nombres</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">apellidos</TD><TD ALIGN="LEFT">varchar(120)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">email_institucional</TD><TD ALIGN="LEFT">citext</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"limite_login" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>limite_login</B></FONT></TD></TR><TR><TD ALIGN="LEFT">clave</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">intentos</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">ventana</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"rol" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>rol</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">U !</TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">varchar(120)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"sesion_usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>sesion_usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R67 !</TD></TR><TR><TD ALIGN="LEFT">creada_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">expira_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">ultimo_uso_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">revocada_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">citext</TD><TD ALIGN="LEFT">U !</TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">varchar(160)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">proveedor_identidad</TD><TD ALIGN="LEFT">varchar(60)</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">identidad_externa</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">ultimo_acceso_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"usuario_rol" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174b3b"><TR><TD COLSPAN="3" BGCOLOR="#174b3b"><FONT COLOR="white" POINT-SIZE="12"><B>usuario_rol</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK !</TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R70 !</TD></TR><TR><TD ALIGN="LEFT">rol_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R69 !</TD></TR><TR><TD ALIGN="LEFT">alcance</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">vigente_desde</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR><TR><TD ALIGN="LEFT">vigente_hasta</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">?</TD></TR><TR><TD ALIGN="LEFT">asignado_por</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">R68 ?</TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">!</TD></TR></TABLE>>];
"evento_auditoria" -> "usuario" [label="R46  0..N : 0..1", style="dashed"];
"funcionario" -> "usuario" [label="R47  0..1 : 1", style="solid"];
"sesion_usuario" -> "usuario" [label="R67  0..N : 1", style="solid"];
"usuario_rol" -> "usuario" [label="R68  0..N : 0..1", style="dashed"];
"usuario_rol" -> "rol" [label="R69  0..N : 1", style="solid"];
"usuario_rol" -> "usuario" [label="R70  0..N : 1", style="solid"];
}
